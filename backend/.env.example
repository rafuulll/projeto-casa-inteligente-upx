# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copie este arquivo para .env e preencha com seus valores reais
# O arquivo .env NUNCA deve ser enviado para o GitHub (já está no .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL (usado pelo Prisma)
# Para rodar localmente fora do Docker, certifique-se de ter o Postgres rodando
DATABASE_URL="postgresql://user:password@localhost:5432/casa_inteligente?schema=public"

# Broker MQTT
# Para simulação com Wokwi: usar o broker público HiveMQ
# Para produção (ESP32 físico): usar o broker interno do Docker (mqtt://mosquitto:1883)
MQTT_BROKER="mqtt://broker.hivemq.com:1883"

# Porta do servidor backend (opcional, padrão: 3001)
PORT=3001

# Chave da API do Claude (Anthropic)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY="sua_api_key"